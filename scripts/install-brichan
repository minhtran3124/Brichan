#!/bin/sh
set -eu

PROGRAM=${0##*/}
COMMANDS="brichan brichan-codex brichan-claude brichan-herdr-agent-start brichan-validate-receipts"

usage() {
    cat <<EOF
Usage: $PROGRAM [options]

Install Brichan into a dedicated virtual environment outside the source checkout.
No virtualenv activation is required.

Options:
  --install-root PATH  Tool state root (default: \$XDG_DATA_HOME/brichan or
                       \$HOME/.local/share/brichan)
  --bin-dir PATH       Command symlink directory (default: \$HOME/.local/bin)
  --python COMMAND     Python 3.10+ interpreter with pip, setuptools, venv,
                       and wheel
  -h, --help           Show this help
EOF
}

fail() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 2
}

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
SOURCE_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)
INSTALL_ROOT=
BIN_DIR=
REQUESTED_PYTHON=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --install-root)
            [ "$#" -ge 2 ] || fail "--install-root requires a path"
            INSTALL_ROOT=$2
            shift 2
            ;;
        --install-root=*)
            INSTALL_ROOT=${1#*=}
            shift
            ;;
        --bin-dir)
            [ "$#" -ge 2 ] || fail "--bin-dir requires a path"
            BIN_DIR=$2
            shift 2
            ;;
        --bin-dir=*)
            BIN_DIR=${1#*=}
            shift
            ;;
        --python)
            [ "$#" -ge 2 ] || fail "--python requires a command"
            REQUESTED_PYTHON=$2
            shift 2
            ;;
        --python=*)
            REQUESTED_PYTHON=${1#*=}
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            fail "unknown option: $1"
            ;;
    esac
done

[ -f "$SOURCE_ROOT/pyproject.toml" ] || fail "cannot find Brichan pyproject.toml"
[ -d "$SOURCE_ROOT/src/brichan" ] || fail "cannot find Brichan source package"

if [ -z "$INSTALL_ROOT" ]; then
    if [ -n "${XDG_DATA_HOME:-}" ]; then
        INSTALL_ROOT=$XDG_DATA_HOME/brichan
    elif [ -n "${HOME:-}" ]; then
        INSTALL_ROOT=$HOME/.local/share/brichan
    else
        fail "HOME or XDG_DATA_HOME is required unless --install-root is set"
    fi
fi

if [ -z "$BIN_DIR" ]; then
    [ -n "${HOME:-}" ] || fail "HOME is required unless --bin-dir is set"
    BIN_DIR=$HOME/.local/bin
fi

mkdir -p "$INSTALL_ROOT" "$BIN_DIR"
INSTALL_ROOT=$(CDPATH= cd -- "$INSTALL_ROOT" && pwd -P)
BIN_DIR=$(CDPATH= cd -- "$BIN_DIR" && pwd -P)
VENV_DIR=$INSTALL_ROOT/venv

for command_name in $COMMANDS; do
    command_link=$BIN_DIR/$command_name
    if [ -e "$command_link" ] || [ -L "$command_link" ]; then
        [ -L "$command_link" ] || fail "refusing to overwrite: $command_link"
        existing_target=$(readlink "$command_link")
        case "$existing_target" in
            "$VENV_DIR"/bin/*) ;;
            *) fail "refusing to replace unrelated symlink: $command_link" ;;
        esac
    fi
done

python_is_usable() {
    "$1" -c '
import sys
import importlib.util
required = ("pip", "setuptools", "venv", "wheel")
missing = [name for name in required if importlib.util.find_spec(name) is None]
raise SystemExit(0 if sys.version_info >= (3, 10) and not missing else 1)
' >/dev/null 2>&1
}

PYTHON_COMMAND=
if [ -n "$REQUESTED_PYTHON" ]; then
    resolved_python=$(command -v "$REQUESTED_PYTHON" 2>/dev/null || true)
    [ -n "$resolved_python" ] || fail "Python command not found: $REQUESTED_PYTHON"
    python_is_usable "$resolved_python" || fail \
        "$REQUESTED_PYTHON must be Python 3.10+ with pip, setuptools, venv, and wheel"
    PYTHON_COMMAND=$resolved_python
else
    for candidate in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
        resolved_python=$(command -v "$candidate" 2>/dev/null || true)
        if [ -n "$resolved_python" ] && python_is_usable "$resolved_python"; then
            PYTHON_COMMAND=$resolved_python
            break
        fi
    done
    [ -n "$PYTHON_COMMAND" ] || fail \
        "no Python 3.10+ interpreter with pip, setuptools, venv, and wheel was found; use --python"
fi

WORK_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/brichan-install.XXXXXX") ||
    fail "cannot create temporary build directory"
cleanup() {
    rm -rf -- "$WORK_ROOT"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM HUP

SNAPSHOT_ROOT=$WORK_ROOT/source
WHEEL_DIR=$WORK_ROOT/wheel
mkdir -p "$SNAPSHOT_ROOT" "$WHEEL_DIR"
for source_name in pyproject.toml README.md LICENSE; do
    [ -f "$SOURCE_ROOT/$source_name" ] ||
        fail "required package input is missing: $source_name"
    cp "$SOURCE_ROOT/$source_name" "$SNAPSHOT_ROOT/$source_name"
done
cp -R "$SOURCE_ROOT/src" "$SNAPSHOT_ROOT/src"

printf 'Building Brichan wheel with %s...\n' "$PYTHON_COMMAND"
"$PYTHON_COMMAND" -m pip wheel "$SNAPSHOT_ROOT" \
    --no-deps \
    --no-build-isolation \
    --wheel-dir "$WHEEL_DIR"

WHEEL_PATH=
WHEEL_COUNT=0
for candidate in "$WHEEL_DIR"/*.whl; do
    [ -f "$candidate" ] || continue
    WHEEL_PATH=$candidate
    WHEEL_COUNT=$((WHEEL_COUNT + 1))
done
[ "$WHEEL_COUNT" -eq 1 ] ||
    fail "expected exactly one wheel, found $WHEEL_COUNT"

if [ -e "$VENV_DIR" ]; then
    [ -x "$VENV_DIR/bin/python" ] ||
        fail "existing install is not a usable virtual environment: $VENV_DIR"
    "$VENV_DIR/bin/python" -m pip --version >/dev/null 2>&1 || fail \
        "existing environment at $VENV_DIR has no usable pip; choose a fresh --install-root, or inspect and remove the dedicated environment yourself, then rerun this installer"
else
    printf 'Creating dedicated environment at %s...\n' "$VENV_DIR"
    "$PYTHON_COMMAND" -m venv "$VENV_DIR"
fi

printf 'Installing %s...\n' "$(basename -- "$WHEEL_PATH")"
"$VENV_DIR/bin/python" -m pip install \
    --no-deps \
    --force-reinstall \
    "$WHEEL_PATH"

"$VENV_DIR/bin/python" -c 'import brichan'
for command_name in $COMMANDS; do
    command_target=$VENV_DIR/bin/$command_name
    command_link=$BIN_DIR/$command_name
    [ -x "$command_target" ] || fail "installed command is missing: $command_target"
    if [ -L "$command_link" ]; then
        rm -f -- "$command_link"
    fi
    ln -s "$command_target" "$command_link"
done

INSTALLED_VERSION=$(
    "$VENV_DIR/bin/python" -c 'import brichan; print(brichan.__version__)'
)
printf '\nBrichan %s installed successfully.\n' "$INSTALLED_VERSION"
printf 'Environment: %s\n' "$VENV_DIR"
printf 'Commands:    %s\n' "$BIN_DIR"
printf 'No virtualenv activation is required.\n'

case ":${PATH:-}:" in
    *":$BIN_DIR:"*)
        printf '\nStart with:\n'
        printf '  brichan init --project /absolute/path/to/repository\n'
        printf '  brichan init --apply --project /absolute/path/to/repository\n'
        printf '  brichan run --project /absolute/path/to/repository\n'
        ;;
    *)
        printf '\n%s is not currently on PATH. Add this to your shell profile:\n' "$BIN_DIR"
        printf '  export PATH="%s:$PATH"\n' "$BIN_DIR"
        printf '\nUntil then, start with:\n'
        printf '  %s/brichan init --project /absolute/path/to/repository\n' "$BIN_DIR"
        ;;
esac
