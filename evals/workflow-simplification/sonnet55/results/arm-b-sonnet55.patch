@@ -0,0 +1,42 @@
+import unittest
+
+from path_guard import validate_ledger_path
+
+
+class NormalizationTest(unittest.TestCase):
+    def test_redundant_segments_are_normalized(self):
+        for value, expected in [
+            ("ledger/./workers.jsonl", "ledger/workers.jsonl"),
+            ("ledger//workers.jsonl", "ledger/workers.jsonl"),
+            ("./ledger///.//workers.jsonl", "ledger/workers.jsonl"),
+            ("workers.jsonl", "workers.jsonl"),
+        ]:
+            with self.subTest(value=value):
+                self.assertEqual(expected, validate_ledger_path(value))
+
+    def test_invariants_hold_when_hidden_by_redundant_segments(self):
+        for value in [
+            "a/./../b.jsonl",
+            "a//../b.jsonl",
+            "a/b/..//c.jsonl",
+            "ledger/.brichan/x.jsonl",
+            ".//.BRICHAN/x.jsonl",
+            "a/./.BriChan//x.jsonl",
+            "/abs.jsonl",
+            "//abs.jsonl",
+            "a\\b.jsonl",
+            "a/b\x00.jsonl",
+            "ledger/x.txt",
+            "ledger/x.jsonl/",
+            "ledger/x.jsonl/.",
+            "ledger/x.jsonl//",
+            ".",
+            "./",
+            "",
+        ]:
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                validate_ledger_path(value)
+
+
+if __name__ == "__main__":
+    unittest.main()
