@@ -0,0 +1,76 @@
+import unittest
+
+from ledger_summary import summarize
+
+
+def rec(event, launch_id, **extra):
+    import json
+
+    return json.dumps({"event": event, "launch_id": launch_id, **extra}).encode()
+
+
+class LedgerRulesTest(unittest.TestCase):
+    def test_blank_lines_ignored_but_bad_lines_counted(self):
+        data = b"\n  \t\r\n" + rec("launched", "a") + b"\n[1]\n\xff\n{bad\n" + (
+            b'{"event": "launched", "launch_id": 3}\n'
+            b'{"event": "started", "launch_id": "a"}\n'
+            b'{"event": "finished"}\n'
+        )
+        result = summarize(data)
+        self.assertEqual(6, result["undecodable"])
+        self.assertEqual(["a"], result["unknown"])
+
+    def test_pairs_by_launch_id_and_orders_by_launch(self):
+        data = b"\n".join(
+            [
+                rec("launched", "b", worker="w", pane_id="p"),
+                rec("launched", "a", worker="w", pane_id="p"),
+                rec("finished", "a", worker="x", pane_id="q"),
+                rec("finished", "b"),
+            ]
+        )
+        result = summarize(data)  # no trailing newline
+        self.assertEqual(["b", "a"], result["finished"])
+        self.assertEqual([], result["unknown"])
+
+    def test_duplicates_orphans_and_unknown(self):
+        data = b"\n".join(
+            [
+                rec("finished", "o"),
+                rec("launched", "a"),
+                rec("launched", "a"),
+                rec("finished", "a"),
+                rec("finished", "a"),
+                rec("finished", "o"),
+                rec("launched", "u"),
+                rec("finished", "late"),
+                rec("launched", "late"),
+            ]
+        )
+        self.assertEqual(
+            {
+                "finished": ["a", "late"],
+                "unknown": ["u"],
+                "orphans": ["o"],
+                "undecodable": 0,
+                "duplicate_finished": 2,
+                "duplicate_launched": 1,
+            },
+            summarize(data),
+        )
+
+    def test_crlf_line_is_valid(self):
+        result = summarize(rec("launched", "a") + b"\r\n" + rec("finished", "a") + b"\r\n")
+        self.assertEqual(["a"], result["finished"])
+        self.assertEqual(0, result["undecodable"])
+
+    def test_line_separator_chars_do_not_split_records(self):
+        # \x0c is not a line break for this format; it is JSON-invalid inside a line.
+        data = rec("launched", "a") + b"\x0c" + rec("launched", "b") + b"\n"
+        result = summarize(data)
+        self.assertEqual(1, result["undecodable"])
+        self.assertEqual([], result["unknown"])
+
+
+if __name__ == "__main__":
+    unittest.main()
