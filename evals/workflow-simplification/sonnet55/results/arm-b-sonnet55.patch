+++ b/evals/workflow-simplification/stage1/t2-prerelease-order/test_precedence.py
@@ -0,0 +1,55 @@
+import unittest
+
+from semver_order import compare, sort_versions
+
+
+class PrecedenceTest(unittest.TestCase):
+    def test_reported_bug_numeric_identifiers_compare_numerically(self):
+        self.assertEqual(
+            ["1.0.0-rc.2", "1.0.0-rc.10", "1.0.0"],
+            sort_versions(["1.0.0-rc.10", "1.0.0-rc.2", "1.0.0"]),
+        )
+
+    def test_semver_spec_example_chain(self):
+        chain = [
+            "1.0.0-alpha",
+            "1.0.0-alpha.1",
+            "1.0.0-alpha.beta",
+            "1.0.0-beta",
+            "1.0.0-beta.2",
+            "1.0.0-beta.11",
+            "1.0.0-rc.1",
+            "1.0.0",
+        ]
+        self.assertEqual(chain, sort_versions(list(reversed(chain))))
+        for lower, higher in zip(chain, chain[1:]):
+            self.assertEqual(-1, compare(lower, higher))
+            self.assertEqual(1, compare(higher, lower))
+
+    def test_ascii_order_for_alphanumeric_identifiers(self):
+        self.assertEqual(-1, compare("1.0.0-Z", "1.0.0-a"))
+        self.assertEqual(-1, compare("1.0.0-1a", "1.0.0-1b"))
+        self.assertEqual(-1, compare("1.0.0-a-", "1.0.0-a0"))
+
+    def test_numeric_below_alphanumeric_even_when_larger(self):
+        self.assertEqual(-1, compare("1.0.0-99999", "1.0.0-0a"))
+
+    def test_build_metadata_ignored(self):
+        self.assertEqual(0, compare("1.0.0+a", "1.0.0+b"))
+        self.assertEqual(0, compare("1.0.0-rc.1+x", "1.0.0-rc.1"))
+
+    def test_sort_is_stable_for_equal_precedence(self):
+        self.assertEqual(["1.0.0+b", "1.0.0+a"], sort_versions(["1.0.0+b", "1.0.0+a"]))
+
+    def test_core_compared_numerically(self):
+        self.assertEqual(-1, compare("1.9.0", "1.10.0"))
+
+    def test_invalid_versions_rejected(self):
+        for bad in ["1.0.0\\n", "1.0.0\n", "01.0.0", "1.0.0-01", "1.0.0-", "1.0.0-a..b",
+                    "١.0.0", "1.0.0-١", "", "v1.0.0"]:
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                compare(bad, "1.0.0")
+
+
+if __name__ == "__main__":
+    unittest.main()
