+++ b/evals/workflow-simplification/stage1/t1-ledger-summary/ledger_summary.py
@@ -2,6 +2,65 @@
 
 from __future__ import annotations
 
+import json
+
+_EVENTS = ("launched", "finished")
+
+
+def _decode(line: bytes):
+    """Return (event, launch_id), None for a blank line, or False if undecodable."""
+    try:
+        text = line.decode("utf-8")
+    except UnicodeDecodeError:
+        return False
+    if not text.strip():
+        return None
+    try:
+        record = json.loads(text)
+    except (ValueError, RecursionError):
+        return False
+    if not isinstance(record, dict):
+        return False
+    event = record.get("event")
+    launch_id = record.get("launch_id")
+    if not isinstance(launch_id, str) or event not in _EVENTS:
+        return False
+    return event, launch_id
+
 
 def summarize(data: bytes) -> dict:
-    raise NotImplementedError
+    launched: list[str] = []  # first-launch order
+    launched_set: set[str] = set()
+    finished_set: set[str] = set()
+    orphan_candidates: list[str] = []  # first finished occurrence order
+    undecodable = duplicate_finished = duplicate_launched = 0
+
+    # Split on b"\n" only: str.splitlines() would also split on \x0b, \x0c, etc.
+    for line in data.split(b"\n"):
+        decoded = _decode(line)
+        if decoded is None:
+            continue
+        if decoded is False:
+            undecodable += 1
+            continue
+        event, launch_id = decoded
+        if event == "launched":
+            if launch_id in launched_set:
+                duplicate_launched += 1
+            else:
+                launched_set.add(launch_id)
+                launched.append(launch_id)
+        elif launch_id in finished_set:
+            duplicate_finished += 1
+        else:
+            finished_set.add(launch_id)
+            orphan_candidates.append(launch_id)
+
+    return {
+        "finished": [i for i in launched if i in finished_set],
+        "unknown": [i for i in launched if i not in finished_set],
+        "orphans": [i for i in orphan_candidates if i not in launched_set],
+        "undecodable": undecodable,
+        "duplicate_finished": duplicate_finished,
+        "duplicate_launched": duplicate_launched,
+    }
