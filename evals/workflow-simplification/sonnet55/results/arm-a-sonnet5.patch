+def _compare_identifier(a: str, b: str) -> int:
+    """Compare two dot-separated prerelease identifiers per SemVer 2.0.0.
+
+    Numeric identifiers compare numerically and always have lower precedence
+    than alphanumeric identifiers; otherwise identifiers compare as ASCII
+    strings.
+    """
+    a_numeric = a.isdigit()
+    b_numeric = b.isdigit()
+    if a_numeric and b_numeric:
+        a_int, b_int = int(a), int(b)
+        return -1 if a_int < b_int else (1 if a_int > b_int else 0)
+    if a_numeric != b_numeric:
+        return -1 if a_numeric else 1
+    return -1 if a < b else (1 if a > b else 0)
+
+
+def _compare_prerelease(pre_a: tuple[str, ...], pre_b: tuple[str, ...]) -> int:
+    for ident_a, ident_b in zip(pre_a, pre_b):
+        result = _compare_identifier(ident_a, ident_b)
+        if result != 0:
+            return result
+    # All shared identifiers are equal: the larger set has higher precedence.
+    if len(pre_a) != len(pre_b):
+        return -1 if len(pre_a) < len(pre_b) else 1
+    return 0
+
+
