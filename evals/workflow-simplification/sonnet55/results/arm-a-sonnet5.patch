@@ -0,0 +1,131 @@
+import unittest
+
+from ledger_summary import summarize
+
+
+def lines(*objs_or_bytes):
+    out = []
+    for item in objs_or_bytes:
+        if isinstance(item, bytes):
+            out.append(item)
+        else:
+            out.append(item.encode("utf-8"))
+    return b"\n".join(out)
+
+
+class LedgerSummaryTest(unittest.TestCase):
+    def test_empty_and_whitespace_lines_ignored(self):
+        data = (
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b"\n"
+            b"   \n"
+            b'{"event": "finished", "launch_id": "a"}\n'
+        )
+        result = summarize(data)
+        self.assertEqual(["a"], result["finished"])
+        self.assertEqual(0, result["undecodable"])
+
+    def test_invalid_utf8_counted_undecodable(self):
+        data = b'{"event": "launched", "launch_id": "a"}\n' + b"\xff\xfe\n"
+        result = summarize(data)
+        self.assertEqual(1, result["undecodable"])
+        self.assertEqual(["a"], result["unknown"])
+
+    def test_invalid_json_counted_undecodable(self):
+        data = b"not json\n"
+        result = summarize(data)
+        self.assertEqual(1, result["undecodable"])
+
+    def test_json_not_object_counted_undecodable(self):
+        data = b"[1, 2, 3]\n"
+        result = summarize(data)
+        self.assertEqual(1, result["undecodable"])
+
+    def test_missing_keys_counted_undecodable(self):
+        data = b'{"event": "launched"}\n' + b'{"launch_id": "a"}\n'
+        result = summarize(data)
+        self.assertEqual(2, result["undecodable"])
+
+    def test_non_string_values_counted_undecodable(self):
+        data = b'{"event": 1, "launch_id": "a"}\n' + b'{"event": "launched", "launch_id": 2}\n'
+        result = summarize(data)
+        self.assertEqual(2, result["undecodable"])
+
+    def test_unknown_event_value_counted_undecodable(self):
+        data = b'{"event": "cancelled", "launch_id": "a"}\n'
+        result = summarize(data)
+        self.assertEqual(1, result["undecodable"])
+
+    def test_launch_id_not_join_key_worker_or_pane_ignored(self):
+        data = (
+            b'{"event": "launched", "launch_id": "a", "worker": "w1"}\n'
+            b'{"event": "finished", "launch_id": "a", "worker": "w2"}\n'
+        )
+        result = summarize(data)
+        self.assertEqual(["a"], result["finished"])
+
+    def test_duplicate_finished_counted_and_first_wins(self):
+        data = (
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b'{"event": "finished", "launch_id": "a"}\n'
+            b'{"event": "finished", "launch_id": "a"}\n'
+        )
+        result = summarize(data)
+        self.assertEqual(["a"], result["finished"])
+        self.assertEqual(1, result["duplicate_finished"])
+
+    def test_orphan_finished_before_any_launched_record(self):
+        data = b'{"event": "finished", "launch_id": "a"}\n'
+        result = summarize(data)
+        self.assertEqual(["a"], result["orphans"])
+        self.assertEqual([], result["finished"])
+        self.assertEqual([], result["unknown"])
+
+    def test_finished_before_its_launched_record_is_not_orphan(self):
+        data = (
+            b'{"event": "finished", "launch_id": "a"}\n'
+            b'{"event": "launched", "launch_id": "a"}\n'
+        )
+        result = summarize(data)
+        self.assertEqual([], result["orphans"])
+        self.assertEqual(["a"], result["finished"])
+
+    def test_unknown_for_launched_never_finished(self):
+        data = b'{"event": "launched", "launch_id": "a"}\n'
+        result = summarize(data)
+        self.assertEqual(["a"], result["unknown"])
+        self.assertEqual([], result["finished"])
+
+    def test_duplicate_launched_counted_and_first_wins(self):
+        data = (
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b'{"event": "finished", "launch_id": "a"}\n'
+        )
+        result = summarize(data)
+        self.assertEqual(["a"], result["finished"])
+        self.assertEqual(1, result["duplicate_launched"])
+
+    def test_final_line_without_trailing_newline(self):
+        data = b'{"event": "launched", "launch_id": "a"}'
+        result = summarize(data)
+        self.assertEqual(["a"], result["unknown"])
+
+    def test_trailing_cr_before_newline_does_not_break_valid_record(self):
+        data = b'{"event": "launched", "launch_id": "a"}\r\n' + b'{"event": "finished", "launch_id": "a"}\r\n'
+        result = summarize(data)
+        self.assertEqual(["a"], result["finished"])
+        self.assertEqual(0, result["undecodable"])
+
+    def test_orphans_no_repeats_first_occurrence_order(self):
+        data = (
+            b'{"event": "finished", "launch_id": "a"}\n'
+            b'{"event": "finished", "launch_id": "b"}\n'
+        )
+        result = summarize(data)
+        self.assertEqual(["a", "b"], result["orphans"])
+        self.assertEqual(0, result["duplicate_finished"])
+
+
+if __name__ == "__main__":
+    unittest.main()
