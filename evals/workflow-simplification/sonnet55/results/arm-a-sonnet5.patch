index 0000000..697532e
--- /dev/null
+++ b/evals/workflow-simplification/stage1/t2-prerelease-order/test_semver_order.py
@@ -0,0 +1,47 @@
+import unittest
+
+from semver_order import compare, sort_versions
+
+
+class SemverOrderTest(unittest.TestCase):
+    def test_numeric_prerelease_identifiers_compare_numerically(self):
+        self.assertEqual(
+            ["1.0.0-rc.2", "1.0.0-rc.10", "1.0.0"],
+            sort_versions(["1.0.0-rc.10", "1.0.0-rc.2", "1.0.0"]),
+        )
+
+    def test_numeric_identifier_lower_than_alphanumeric(self):
+        self.assertEqual(-1, compare("1.0.0-1", "1.0.0-alpha"))
+
+    def test_alphanumeric_identifiers_compare_lexically(self):
+        self.assertEqual(-1, compare("1.0.0-alpha", "1.0.0-beta"))
+
+    def test_longer_identifier_set_has_higher_precedence_when_prefix_equal(self):
+        self.assertEqual(-1, compare("1.0.0-alpha", "1.0.0-alpha.1"))
+
+    def test_full_spec_precedence_chain(self):
+        versions = [
+            "1.0.0-alpha",
+            "1.0.0-alpha.1",
+            "1.0.0-alpha.beta",
+            "1.0.0-beta",
+            "1.0.0-beta.2",
+            "1.0.0-beta.11",
+            "1.0.0-rc.1",
+            "1.0.0",
+        ]
+        self.assertEqual(versions, sort_versions(list(reversed(versions))))
+
+    def test_release_beats_prerelease(self):
+        self.assertEqual(1, compare("1.0.0", "1.0.0-rc.1"))
+
+    def test_equal_versions(self):
+        self.assertEqual(0, compare("1.0.0-rc.2", "1.0.0-rc.2"))
+
+    def test_invalid_still_raises(self):
+        with self.assertRaises(ValueError):
+            compare("1.0", "1.0.0")
+
+
+if __name__ == "__main__":
+    unittest.main()
