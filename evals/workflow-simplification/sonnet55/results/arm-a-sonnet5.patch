--- /dev/null
+++ b/evals/workflow-simplification/stage1/t3-path-guard/test_path_guard.py
@@ -0,0 +1,66 @@
+import unittest
+
+from path_guard import validate_ledger_path
+
+
+class PathGuardTest(unittest.TestCase):
+    def test_dot_component_normalized(self):
+        self.assertEqual(
+            "ledger/workers.jsonl", validate_ledger_path("ledger/./workers.jsonl")
+        )
+
+    def test_repeated_separator_normalized(self):
+        self.assertEqual(
+            "ledger/workers.jsonl", validate_ledger_path("ledger//workers.jsonl")
+        )
+
+    def test_leading_dot_component_normalized(self):
+        self.assertEqual(
+            "ledger/workers.jsonl", validate_ledger_path("./ledger/workers.jsonl")
+        )
+
+    def test_trailing_separator_normalized(self):
+        self.assertEqual(
+            "ledger/workers.jsonl", validate_ledger_path("ledger/workers.jsonl/")
+        )
+
+    def test_absolute_path_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_ledger_path("/ledger/workers.jsonl")
+
+    def test_parent_component_rejected_even_amid_redundant_segments(self):
+        with self.assertRaises(ValueError):
+            validate_ledger_path("ledger/.//../workers.jsonl")
+
+    def test_dotbrichan_component_rejected_any_case(self):
+        with self.assertRaises(ValueError):
+            validate_ledger_path("ledger/.BrIcHaN/workers.jsonl")
+
+    def test_backslash_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_ledger_path("ledger\\workers.jsonl")
+
+    def test_nul_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_ledger_path("ledger/\x00workers.jsonl")
+
+    def test_missing_jsonl_suffix_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_ledger_path("ledger/workers.txt")
+
+    def test_only_dot_components_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_ledger_path("./.")
+
+    def test_empty_path_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_ledger_path("")
+
+    def test_already_normalized_path_unchanged(self):
+        self.assertEqual(
+            "ledger/workers.jsonl", validate_ledger_path("ledger/workers.jsonl")
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
