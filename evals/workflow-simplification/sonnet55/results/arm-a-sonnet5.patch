 def summarize(data: bytes) -> dict:
-    raise NotImplementedError
+    undecodable = 0
+
+    records: list[tuple[str, str]] = []
+    for raw_line in data.split(b"\n"):
+        if not raw_line.strip():
+            continue
+        try:
+            text = raw_line.decode("utf-8")
+        except UnicodeDecodeError:
+            undecodable += 1
+            continue
+        try:
+            record = json.loads(text)
+        except ValueError:
+            undecodable += 1
+            continue
+        if not isinstance(record, dict):
+            undecodable += 1
+            continue
+        event = record.get("event")
+        launch_id = record.get("launch_id")
+        if not isinstance(event, str) or not isinstance(launch_id, str):
+            undecodable += 1
+            continue
+        if event not in ("launched", "finished"):
+            undecodable += 1
+            continue
+        records.append((event, launch_id))
+
+    # Orphan status depends on whether a launch_id has a "launched" record
+    # anywhere in the file, not only before the "finished" record, so this
+    # set must be known before classifying any finished record.
+    launched_ids = {lid for event, lid in records if event == "launched"}
+
+    launched_order: list[str] = []
+    launched_seen: set[str] = set()
+    finished_seen: set[str] = set()
+    orphan_order: list[str] = []
+    orphan_seen: set[str] = set()
+    duplicate_finished = 0
+    duplicate_launched = 0
+
+    for event, launch_id in records:
+        if event == "launched":
+            if launch_id in launched_seen:
+                duplicate_launched += 1
+                continue
+            launched_seen.add(launch_id)
+            launched_order.append(launch_id)
+        else:
+            if launch_id in finished_seen:
+                duplicate_finished += 1
+                continue
+            finished_seen.add(launch_id)
+            if launch_id not in launched_ids and launch_id not in orphan_seen:
+                orphan_seen.add(launch_id)
+                orphan_order.append(launch_id)
+
+    finished = [lid for lid in launched_order if lid in finished_seen]
+    unknown = [lid for lid in launched_order if lid not in finished_seen]
+
+    return {
+        "finished": finished,
+        "unknown": unknown,
+        "orphans": orphan_order,
+        "undecodable": undecodable,
+        "duplicate_finished": duplicate_finished,
+        "duplicate_launched": duplicate_launched,
+    }
