@@ -2,6 +2,74 @@
 
 from __future__ import annotations
 
+import json
+
+_EVENTS = ("launched", "finished")
+_BLANK = object()
+
+
+def _decode(raw: bytes):
+    """Return ``(event, launch_id)``, ``_BLANK`` for a blank line, or None."""
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        return None
+    if not text.strip():
+        return _BLANK
+    try:
+        record = json.loads(text)
+    except (ValueError, RecursionError):
+        # ValueError covers JSONDecodeError; deeply nested input can
+        # exhaust the recursion limit instead of failing to parse.
+        return None
+    if not isinstance(record, dict):
+        return None
+    event = record.get("event")
+    launch_id = record.get("launch_id")
+    if not isinstance(event, str) or not isinstance(launch_id, str):
+        return None
+    if event not in _EVENTS:
+        return None
+    return event, launch_id
+
 
 def summarize(data: bytes) -> dict:
-    raise NotImplementedError
+    launched: list[str] = []  # first launched record per id, file order
+    launched_ids: set[str] = set()
+    finished_ids: list[str] = []  # first finished record per id, file order
+    finished_seen: set[str] = set()
+    undecodable = 0
+    duplicate_finished = 0
+    duplicate_launched = 0
+
+    # Split on LF only: a CR before LF stays in the line, where JSON treats
+    # it as whitespace. A missing final LF still yields the last line.
+    for raw in data.split(b"\n"):
+        decoded = _decode(raw)
+        if decoded is _BLANK:
+            continue
+        if decoded is None:
+            undecodable += 1
+            continue
+        event, launch_id = decoded
+        if event == "launched":
+            if launch_id in launched_ids:
+                duplicate_launched += 1
+            else:
+                launched_ids.add(launch_id)
+                launched.append(launch_id)
+        elif launch_id in finished_seen:
+            duplicate_finished += 1
+        else:
+            finished_seen.add(launch_id)
+            finished_ids.append(launch_id)
+
+    # Pairing needs the whole file: a finished record may precede its launch.
+    return {
+        "finished": [i for i in launched if i in finished_seen],
+        "unknown": [i for i in launched if i not in finished_seen],
+        "orphans": [i for i in finished_ids if i not in launched_ids],
+        "undecodable": undecodable,
+        "duplicate_finished": duplicate_finished,
+        "duplicate_launched": duplicate_launched,
+    }
