+def _compare_prerelease(pre_a: tuple[str, ...], pre_b: tuple[str, ...]) -> int:
+    """Compare two non-empty prerelease identifier tuples (spec item 11.4)."""
+    for ident_a, ident_b in zip(pre_a, pre_b):
+        if ident_a == ident_b:
+            continue
+        numeric_a = ident_a.isdigit()
+        numeric_b = ident_b.isdigit()
+        if numeric_a and numeric_b:
+            return -1 if int(ident_a) < int(ident_b) else 1
