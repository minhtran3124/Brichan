+        if numeric_a:
+            return -1
+        if numeric_b:
+            return 1
+        # Alphanumeric identifiers compare lexically in ASCII order.
+        return -1 if ident_a < ident_b else 1
+    # All shared identifiers are equal: the longer set has higher precedence.
+    return -1 if len(pre_a) < len(pre_b) else 1
 
 
