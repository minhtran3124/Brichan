@@ -0,0 +1,44 @@
+import unittest
+
+from path_guard import validate_ledger_path
+
+
+class NormalizeTest(unittest.TestCase):
+    def test_redundant_segments_are_normalized(self):
+        cases = {
+            "ledger/./workers.jsonl": "ledger/workers.jsonl",
+            "ledger//workers.jsonl": "ledger/workers.jsonl",
+            "./ledger/.//./workers.jsonl": "ledger/workers.jsonl",
+            "./workers.jsonl": "workers.jsonl",
+            "a/b/c.jsonl": "a/b/c.jsonl",
+        }
+        for value, expected in cases.items():
+            with self.subTest(value=value):
+                self.assertEqual(expected, validate_ledger_path(value))
+
+    def test_security_invariants_still_reject(self):
+        for value in (
+            "",
+            "/ledger/workers.jsonl",
+            "//ledger/workers.jsonl",  # absolute even though "//" is now allowed
+            "ledger/../workers.jsonl",
+            "ledger/./../workers.jsonl",
+            "./../workers.jsonl",
+            "ledger/.brichan/workers.jsonl",
+            "ledger/./.BriChan//workers.jsonl",
+            "ledger\\workers.jsonl",
+            "ledger/\x00workers.jsonl",
+            "ledger/workers.json",
+            "ledger/workers.jsonl/",  # final component is a directory
+            "ledger/workers.jsonl//",
+            "ledger/workers.jsonl/.",
+            ".",
+            "./",
+            "//",
+        ):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                validate_ledger_path(value)
+
+
+if __name__ == "__main__":
+    unittest.main()
