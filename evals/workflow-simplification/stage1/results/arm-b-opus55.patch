@@ -0,0 +1,109 @@
+import unittest
+
+from ledger_summary import summarize
+
+
+def _summary(**overrides):
+    result = {
+        "finished": [],
+        "unknown": [],
+        "orphans": [],
+        "undecodable": 0,
+        "duplicate_finished": 0,
+        "duplicate_launched": 0,
+    }
+    result.update(overrides)
+    return result
+
+
+class RulesTest(unittest.TestCase):
+    def test_blank_lines_are_not_counted(self):
+        data = b'\n   \n\t\r\n{"event": "launched", "launch_id": "a"}\n\n'
+        self.assertEqual(_summary(unknown=["a"]), summarize(data))
+
+    def test_empty_input(self):
+        self.assertEqual(_summary(), summarize(b""))
+
+    def test_undecodable_line_kinds(self):
+        lines = [
+            b"\xff\xfe",  # invalid UTF-8
+            b"{not json",
+            b'["launched", "a"]',  # not an object
+            b'{"event": "launched"}',  # missing launch_id
+            b'{"launch_id": "a"}',  # missing event
+            b'{"event": "launched", "launch_id": 7}',  # non-string id
+            b'{"event": null, "launch_id": "a"}',  # non-string event
+            b'{"event": "failed", "launch_id": "a"}',  # unknown event
+            b"[" * 100000,  # nesting deep enough to exhaust recursion
+        ]
+        self.assertEqual(
+            _summary(undecodable=len(lines)), summarize(b"\n".join(lines))
+        )
+
+    def test_pairs_by_launch_id_only(self):
+        data = (
+            b'{"event": "launched", "launch_id": "a", "worker": "w", "pane_id": "p"}\n'
+            b'{"event": "finished", "launch_id": "b", "worker": "w", "pane_id": "p"}\n'
+        )
+        self.assertEqual(_summary(unknown=["a"], orphans=["b"]), summarize(data))
+
+    def test_finished_before_launched_still_pairs(self):
+        data = (
+            b'{"event": "finished", "launch_id": "a"}\n'
+            b'{"event": "launched", "launch_id": "a"}\n'
+        )
+        self.assertEqual(_summary(finished=["a"]), summarize(data))
+
+    def test_outputs_follow_launched_record_order(self):
+        data = (
+            b'{"event": "launched", "launch_id": "c"}\n'
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b'{"event": "launched", "launch_id": "b"}\n'
+            b'{"event": "launched", "launch_id": "d"}\n'
+            b'{"event": "finished", "launch_id": "b"}\n'
+            b'{"event": "finished", "launch_id": "c"}\n'
+        )
+        self.assertEqual(
+            _summary(finished=["c", "b"], unknown=["a", "d"]), summarize(data)
+        )
+
+    def test_duplicates_counted_once_per_extra_record(self):
+        data = (
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b'{"event": "finished", "launch_id": "a", "status": "ok"}\n'
+            b'{"event": "finished", "launch_id": "a", "status": "failed"}\n'
+            b'{"event": "finished", "launch_id": "a"}\n'
+        )
+        self.assertEqual(
+            _summary(finished=["a"], duplicate_finished=2, duplicate_launched=1),
+            summarize(data),
+        )
+
+    def test_orphans_first_occurrence_order_no_repeats(self):
+        data = (
+            b'{"event": "finished", "launch_id": "y"}\n'
+            b'{"event": "finished", "launch_id": "x"}\n'
+            b'{"event": "finished", "launch_id": "y"}\n'
+        )
+        self.assertEqual(
+            _summary(orphans=["y", "x"], duplicate_finished=1), summarize(data)
+        )
+
+    def test_crlf_and_missing_final_newline(self):
+        data = (
+            b'{"event": "launched", "launch_id": "a"}\r\n'
+            b'{"event": "finished", "launch_id": "a"}\r'
+        )
+        self.assertEqual(_summary(finished=["a"]), summarize(data))
+
+    def test_undecodable_lines_do_not_affect_pairing(self):
+        data = (
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b'{"event": "finished", "launch_id": "a"\n'  # truncated
+        )
+        self.assertEqual(_summary(unknown=["a"], undecodable=1), summarize(data))
+
+
+if __name__ == "__main__":
+    unittest.main()
