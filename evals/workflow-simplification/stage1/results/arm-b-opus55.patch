index 0000000..223998e
--- /dev/null
+++ b/evals/workflow-simplification/stage1/t2-prerelease-order/test_regression.py
@@ -0,0 +1,72 @@
+import itertools
+import unittest
+
+from semver_order import compare, sort_versions
+
+# Strictly ascending precedence, from SemVer 2.0.0 spec item 11.4 plus the
+# reported rc.2 / rc.10 case.
+SPEC_CHAIN = [
+    "1.0.0-alpha",
+    "1.0.0-alpha.1",
+    "1.0.0-alpha.beta",
+    "1.0.0-beta",
+    "1.0.0-beta.2",
+    "1.0.0-beta.11",
+    "1.0.0-rc.1",
+    "1.0.0-rc.2",
+    "1.0.0-rc.10",
+    "1.0.0",
+]
+
+
+class RegressionTest(unittest.TestCase):
+    def test_reported_example(self):
+        self.assertEqual(
+            ["1.0.0-rc.2", "1.0.0-rc.10", "1.0.0"],
+            sort_versions(["1.0.0-rc.10", "1.0.0-rc.2", "1.0.0"]),
+        )
+
+    def test_spec_chain_pairwise(self):
+        for (i, a), (j, b) in itertools.product(enumerate(SPEC_CHAIN), repeat=2):
+            with self.subTest(a=a, b=b):
+                self.assertEqual((i > j) - (i < j), compare(a, b))
+
+    def test_numeric_identifiers_compare_as_integers(self):
+        # Also beyond 64-bit range, which SemVer does not cap.
+        self.assertEqual(-1, compare("1.0.0-9", "1.0.0-10"))
+        self.assertEqual(
+            -1, compare("1.0.0-99999999999999999999", "1.0.0-100000000000000000000")
+        )
+
+    def test_numeric_below_alphanumeric_even_if_ascii_says_otherwise(self):
+        # "-" (0x2D) sorts before digits in ASCII, but "-" is alphanumeric.
+        self.assertEqual(-1, compare("1.0.0-1", "1.0.0--"))
+        self.assertEqual(-1, compare("1.0.0-999", "1.0.0-0a"))
+
+    def test_alphanumeric_identifiers_compare_in_ascii_order(self):
+        self.assertEqual(-1, compare("1.0.0-Z", "1.0.0-a"))
+        self.assertEqual(-1, compare("1.0.0-a1", "1.0.0-a10"))
+
+    def test_build_metadata_ignored_and_sort_stable(self):
+        self.assertEqual(0, compare("1.0.0-rc.1+b1", "1.0.0-rc.1+b2"))
+        self.assertEqual(
+            ["1.0.0+z", "1.0.0+a"], sort_versions(["1.0.0+z", "1.0.0+a"])
+        )
+
+    def test_invalid_versions_raise(self):
+        for bad in (
+            "1.0.0\n",  # "$" alone would accept a trailing newline
+            "1\N{ARABIC-INDIC DIGIT ONE}.0.0",  # non-ASCII digit in core
+            "1.0.0-\N{ARABIC-INDIC DIGIT ONE}a",  # ... and in a prerelease
+            "1.0.0-01",  # leading zero in numeric identifier
+            "1.0.0-",
+            "1.0.0-rc..1",
+            "01.0.0",
+            "1.0.0+",
+        ):
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                compare(bad, "1.0.0")
+
+
+if __name__ == "__main__":
+    unittest.main()
