@@ -0,0 +1,135 @@
+"""Rule-by-rule coverage for summarize(). Each case names the rule it pins."""
+
+import unittest
+
+from ledger_summary import summarize
+
+
+def summary(**overrides):
+    base = {
+        "finished": [],
+        "unknown": [],
+        "orphans": [],
+        "undecodable": 0,
+        "duplicate_finished": 0,
+        "duplicate_launched": 0,
+    }
+    base.update(overrides)
+    return base
+
+
+class SummarizeTest(unittest.TestCase):
+    def test_blank_lines_are_ignored_everywhere(self):
+        # Rule 1 + rule 8: blank, whitespace-only and bare-CR lines are not
+        # undecodable, and a missing trailing newline still yields a line.
+        data = b"\n   \n\t\n\r\n{\"event\": \"launched\", \"launch_id\": \"a\"}"
+        self.assertEqual(summary(unknown=["a"]), summarize(data))
+
+    def test_empty_input(self):
+        self.assertEqual(summary(), summarize(b""))
+
+    def test_crlf_record_is_decodable(self):
+        # Rule 8: a trailing \r is JSON whitespace, not corruption.
+        data = b'{"event": "launched", "launch_id": "a"}\r\n'
+        self.assertEqual(summary(unknown=["a"]), summarize(data))
+
+    def test_unknown_for_launch_without_finish(self):
+        # Rule 6: never "running" or "failed".
+        data = b'{"event": "launched", "launch_id": "a"}\n'
+        self.assertEqual(summary(unknown=["a"]), summarize(data))
+
+    def test_undecodable_shapes(self):
+        # Rule 2: every listed malformed shape lands in undecodable.
+        lines = [
+            b"not json",
+            b"[1, 2]",
+            b'"a string"',
+            b"null",
+            b'{"event": "launched"}',
+            b'{"launch_id": "a"}',
+            b'{"event": 1, "launch_id": "a"}',
+            b'{"event": "launched", "launch_id": 1}',
+            b'{"event": "launched", "launch_id": null}',
+            b'{"event": "crashed", "launch_id": "a"}',
+            b'{"event": "launched", "launch_id": "a"',
+            b'{"event": "launched", "launch_id": "\xff\xfe"}',
+        ]
+        self.assertEqual(
+            summary(undecodable=len(lines)), summarize(b"\n".join(lines) + b"\n")
+        )
+
+    def test_extra_keys_are_ignored(self):
+        # Rule 3: pairing is by launch_id only; worker/pane_id never join.
+        data = (
+            b'{"event": "launched", "launch_id": "a", "worker": "w1", "pane_id": "p1"}\n'
+            b'{"event": "finished", "launch_id": "a", "worker": "w2", "pane_id": "p2"}\n'
+        )
+        self.assertEqual(summary(finished=["a"]), summarize(data))
+
+    def test_same_worker_different_launch_ids_do_not_pair(self):
+        # Rule 3: a shared worker must not make "b" look finished.
+        data = (
+            b'{"event": "launched", "launch_id": "a", "worker": "w"}\n'
+            b'{"event": "launched", "launch_id": "b", "worker": "w"}\n'
+            b'{"event": "finished", "launch_id": "a", "worker": "w"}\n'
+        )
+        self.assertEqual(summary(finished=["a"], unknown=["b"]), summarize(data))
+
+    def test_duplicate_finished_counted_once_per_extra(self):
+        # Rule 4: first finish wins, later ones are counted, not listed twice.
+        data = (
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b'{"event": "finished", "launch_id": "a"}\n'
+            b'{"event": "finished", "launch_id": "a"}\n'
+            b'{"event": "finished", "launch_id": "a"}\n'
+        )
+        self.assertEqual(
+            summary(finished=["a"], duplicate_finished=2), summarize(data)
+        )
+
+    def test_duplicate_launched_counted(self):
+        # Rule 7: only the first launched record counts.
+        data = (
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b'{"event": "launched", "launch_id": "a"}\n'
+        )
+        self.assertEqual(summary(unknown=["a"], duplicate_launched=1), summarize(data))
+
+    def test_orphan_is_orphan_even_when_launched_never_appears(self):
+        # Rule 5: repeated orphan finishes list once and count as duplicates.
+        data = (
+            b'{"event": "finished", "launch_id": "x"}\n'
+            b'{"event": "finished", "launch_id": "x"}\n'
+        )
+        self.assertEqual(summary(orphans=["x"], duplicate_finished=1), summarize(data))
+
+    def test_finish_before_launch_is_not_an_orphan(self):
+        # Rule 5: "before or after" — a later launched record clears the orphan.
+        data = (
+            b'{"event": "finished", "launch_id": "a"}\n'
+            b'{"event": "launched", "launch_id": "a"}\n'
+        )
+        self.assertEqual(summary(finished=["a"]), summarize(data))
+
+    def test_lists_follow_documented_orders(self):
+        # finished/unknown follow launched order; orphans follow first finish.
+        data = (
+            b'{"event": "launched", "launch_id": "b"}\n'
+            b'{"event": "finished", "launch_id": "y"}\n'
+            b'{"event": "launched", "launch_id": "a"}\n'
+            b'{"event": "launched", "launch_id": "c"}\n'
+            b'{"event": "finished", "launch_id": "x"}\n'
+            b'{"event": "finished", "launch_id": "c"}\n'
+            b'{"event": "finished", "launch_id": "b"}\n'
+        )
+        self.assertEqual(
+            summary(finished=["b", "c"], unknown=["a"], orphans=["y", "x"]),
+            summarize(data),
+        )
+
+    def test_returns_exactly_the_documented_keys(self):
+        self.assertEqual(set(summary()), set(summarize(b"")))
+
+
+if __name__ == "__main__":
+    unittest.main()
