@@ -0,0 +1,102 @@
+"""Regression tests for SemVer 2.0.0 precedence."""
+
+import itertools
+import unittest
+
+from semver_order import compare, parse, sort_versions
+
+
+class ReportedBugTest(unittest.TestCase):
+    def test_reported_example(self):
+        self.assertEqual(
+            ["1.0.0-rc.2", "1.0.0-rc.10", "1.0.0"],
+            sort_versions(["1.0.0-rc.10", "1.0.0-rc.2", "1.0.0"]),
+        )
+
+
+class PrereleasePrecedenceTest(unittest.TestCase):
+    def test_numeric_identifiers_compare_numerically(self):
+        # The root cause: identifiers were compared as text, so "10" < "2".
+        self.assertEqual(-1, compare("1.0.0-9", "1.0.0-10"))
+        self.assertEqual(-1, compare("1.0.0-alpha.2", "1.0.0-alpha.11"))
+
+    def test_numeric_is_lower_than_alphanumeric(self):
+        # Same root cause, second symptom: text order put "1a" below "2".
+        self.assertEqual(1, compare("1.0.0-1a", "1.0.0-2"))
+        self.assertEqual(-1, compare("1.0.0-2", "1.0.0-2a"))
+
+    def test_alphanumeric_identifiers_compare_in_ascii_order(self):
+        self.assertEqual(-1, compare("1.0.0-alpha", "1.0.0-beta"))
+        # Uppercase sorts below lowercase in ASCII.
+        self.assertEqual(-1, compare("1.0.0-RC", "1.0.0-rc"))
+
+    def test_larger_field_set_wins_when_prefix_equal(self):
+        self.assertEqual(-1, compare("1.0.0-alpha", "1.0.0-alpha.1"))
+        self.assertEqual(1, compare("1.0.0-alpha.1.0", "1.0.0-alpha.1"))
+
+    def test_spec_item_11_example_chain(self):
+        # The full example from https://semver.org/#spec-item-11.
+        chain = [
+            "1.0.0-alpha",
+            "1.0.0-alpha.1",
+            "1.0.0-alpha.beta",
+            "1.0.0-beta",
+            "1.0.0-beta.2",
+            "1.0.0-beta.11",
+            "1.0.0-rc.1",
+            "1.0.0",
+        ]
+        self.assertEqual(chain, sort_versions(list(reversed(chain))))
+        for lower, higher in itertools.combinations(chain, 2):
+            self.assertEqual(-1, compare(lower, higher), (lower, higher))
+            self.assertEqual(1, compare(higher, lower), (higher, lower))
+
+
+class CorePrecedenceTest(unittest.TestCase):
+    def test_core_fields_compare_numerically_in_order(self):
+        self.assertEqual(-1, compare("1.9.0", "1.10.0"))
+        self.assertEqual(-1, compare("1.0.9", "1.0.10"))
+        self.assertEqual(-1, compare("2.0.0", "10.0.0"))
+
+    def test_prerelease_of_higher_core_still_wins(self):
+        self.assertEqual(-1, compare("1.0.0", "1.0.1-alpha"))
+
+
+class BuildMetadataTest(unittest.TestCase):
+    def test_build_metadata_is_ignored(self):
+        self.assertEqual(0, compare("1.0.0+a", "1.0.0+b"))
+        self.assertEqual(0, compare("1.0.0-rc.1+a", "1.0.0-rc.1"))
+
+    def test_sort_is_stable_for_equal_precedence(self):
+        versions = ["1.0.0+b", "1.0.0+a", "1.0.0+c"]
+        self.assertEqual(versions, sort_versions(versions))
+
+
+class ValidationTest(unittest.TestCase):
+    def test_invalid_inputs_raise_value_error(self):
+        for value in [
+            "",
+            "1.0",
+            "1.0.0.0",
+            "01.0.0",
+            "1.0.0-",
+            "1.0.0-01",
+            "1.0.0+",
+            "v1.0.0",
+            " 1.0.0",
+            "1.0.0\n",  # "$" used to allow a trailing newline.
+            "1.0.0-rc.1١",  # non-ASCII digit in a numeric identifier.
+        ]:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    parse(value)
+                with self.assertRaises(ValueError):
+                    compare(value, "1.0.0")
+
+    def test_valid_edge_shapes_parse(self):
+        self.assertEqual(((0, 0, 0), ()), parse("0.0.0"))
+        self.assertEqual(((1, 0, 0), ("0", "a-b")), parse("1.0.0-0.a-b+build.1"))
+
+
+if __name__ == "__main__":
+    unittest.main()
