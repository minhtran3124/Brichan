 from __future__ import annotations
 
+import json
+
+_EVENTS = ("launched", "finished")
+
+
+def _decode_record(line: bytes) -> tuple[str, str] | None:
+    """Return ``(event, launch_id)`` for a usable record, else ``None``.
+
+    ``None`` means the line is undecodable: invalid UTF-8, invalid JSON, JSON
+    that is not an object, a missing or non-string ``event``/``launch_id``, or
+    an ``event`` outside ``launched``/``finished``.
+    """
+    try:
+        text = line.decode("utf-8")
+    except UnicodeDecodeError:
+        return None
+    try:
+        record = json.loads(text)
+    except ValueError:
+        return None
+    if not isinstance(record, dict):
+        return None
+    event = record.get("event")
+    launch_id = record.get("launch_id")
+    if not isinstance(event, str) or not isinstance(launch_id, str):
+        return None
+    if event not in _EVENTS:
+        return None
+    return event, launch_id
+
 
 def summarize(data: bytes) -> dict:
-    raise NotImplementedError
+    """Summarize a JSONL worker ledger. See TASK.md for the rules."""
+    launched_order: list[str] = []
+    launched_seen: set[str] = set()
+    finished_order: list[str] = []
+    finished_seen: set[str] = set()
+    undecodable = 0
+    duplicate_launched = 0
+    duplicate_finished = 0
+
+    for line in data.split(b"\n"):
+        # Rule 1: blank and whitespace-only lines are ignored everywhere. This
+        # has to happen after decoding so that a bare "\r" line in a CRLF
+        # ledger is ignored rather than counted as undecodable; a line that
+        # fails to decode cannot be whitespace.
+        try:
+            if not line.decode("utf-8").strip():
+                continue
+        except UnicodeDecodeError:
+            undecodable += 1
+            continue
+
+        decoded = _decode_record(line)
+        if decoded is None:
+            undecodable += 1
+            continue
+        event, launch_id = decoded
+        if event == "launched":
+            # Rule 7: only the first launched record for an id counts.
+            if launch_id in launched_seen:
+                duplicate_launched += 1
+            else:
+                launched_seen.add(launch_id)
+                launched_order.append(launch_id)
+        else:
+            # Rule 4: the first finished record for an id in file order wins.
+            if launch_id in finished_seen:
+                duplicate_finished += 1
+            else:
+                finished_seen.add(launch_id)
+                finished_order.append(launch_id)
+
+    return {
+        "finished": [i for i in launched_order if i in finished_seen],
+        "unknown": [i for i in launched_order if i not in finished_seen],
+        # Rule 5: a finished id with no launched record anywhere in the file.
+        "orphans": [i for i in finished_order if i not in launched_seen],
+        "undecodable": undecodable,
+        "duplicate_finished": duplicate_finished,
+        "duplicate_launched": duplicate_launched,
+    }
