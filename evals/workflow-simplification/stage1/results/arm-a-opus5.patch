+"""Tests for validate_ledger_path: new normalization plus every invariant."""
+
+import unittest
+
+from path_guard import validate_ledger_path
+
+
+class NormalizationTest(unittest.TestCase):
+    def test_reported_examples_are_accepted(self):
+        self.assertEqual(
+            "ledger/workers.jsonl", validate_ledger_path("ledger/./workers.jsonl")
+        )
+        self.assertEqual(
+            "ledger/workers.jsonl", validate_ledger_path("ledger//workers.jsonl")
+        )
+
+    def test_already_normalized_value_is_unchanged(self):
+        self.assertEqual("workers.jsonl", validate_ledger_path("workers.jsonl"))
+        self.assertEqual(
+            "a/b/workers.jsonl", validate_ledger_path("a/b/workers.jsonl")
+        )
+
+    def test_redundant_components_anywhere_are_dropped(self):
+        for value in [
+            "./ledger/workers.jsonl",
+            "ledger/././workers.jsonl",
+            "ledger///workers.jsonl",
+            "ledger/./workers.jsonl/",
+            "ledger/workers.jsonl/.",
+        ]:
+            with self.subTest(value=value):
+                self.assertEqual("ledger/workers.jsonl", validate_ledger_path(value))
+
+    def test_value_that_normalizes_to_nothing_is_rejected(self):
+        for value in [".", "./.", "/", "//"]:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    validate_ledger_path(value)
+
+
+class InvariantTest(unittest.TestCase):
+    def test_empty_value_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_ledger_path("")
+
+    def test_absolute_path_rejected(self):
+        # Normalization must not turn an absolute path into a relative one.
+        for value in ["/workers.jsonl", "//workers.jsonl", "/./workers.jsonl"]:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    validate_ledger_path(value)
+
+    def test_parent_component_rejected_anywhere(self):
+        # Rejected as supplied: "a/../b" must not be normalized into "b".
+        for value in [
+            "../workers.jsonl",
+            "a/../workers.jsonl",
+            "workers.jsonl/..",
+            "a/..//b/workers.jsonl",
+            "./../workers.jsonl",
+        ]:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    validate_ledger_path(value)
+
+    def test_dotted_names_that_are_not_dot_or_dotdot_are_allowed(self):
+        self.assertEqual("...jsonl", validate_ledger_path("...jsonl"))
+        self.assertEqual("..a/b.jsonl", validate_ledger_path("..a/b.jsonl"))
+
+    def test_brichan_component_rejected_in_any_case(self):
+        for value in [
+            ".brichan/workers.jsonl",
+            "a/.BRICHAN/workers.jsonl",
+            "a/.Brichan/workers.jsonl",
+            "a/./.brichan//workers.jsonl",
+        ]:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    validate_ledger_path(value)
+
+    def test_brichan_prefix_is_not_a_brichan_component(self):
+        self.assertEqual(
