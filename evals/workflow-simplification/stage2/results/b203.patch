diff --git a/src/brichan/techstacks/model.py b/src/brichan/techstacks/model.py
index 4d393d8..4c3fae2 100644
--- a/src/brichan/techstacks/model.py
+++ b/src/brichan/techstacks/model.py
@@ -587,13 +587,28 @@ def diagnostic_detail(
     line: int | None = None,
     rule: str | None = None,
 ) -> str:
-    """Return the literal registry detail for one diagnostic code."""
+    """Return the literal registry detail for one diagnostic code.
 
+    Only ``FILESYSTEM_ERROR`` takes ``errno_value`` and only ``INVALID_LEAF``
+    takes ``line`` and ``rule``; a non-``None`` slot the code does not render
+    is a caller error, never silently dropped.
+    """
+
+    spec = DIAGNOSTIC_SPECS[code]
+    taken = {"FILESYSTEM_ERROR": ("errno_value",), "INVALID_LEAF": ("line", "rule")}
+    supplied = (("errno_value", errno_value), ("line", line), ("rule", rule))
+    unsupported = [
+        name
+        for name, value in supplied
+        if value is not None and name not in taken.get(code, ())
+    ]
+    if unsupported:
+        raise ValueError(f"{code} must not carry {' or '.join(unsupported)}")
     if code == "FILESYSTEM_ERROR":
         return filesystem_error_detail(errno_value)
     if code == "INVALID_LEAF":
         return invalid_leaf_detail(line, rule)
-    return DIAGNOSTIC_SPECS[code].detail
+    return spec.detail
 
 
