diff --git a/src/brichan/techstacks/resolver.py b/src/brichan/techstacks/resolver.py
index 6656ca1..8df6f11 100644
--- a/src/brichan/techstacks/resolver.py
+++ b/src/brichan/techstacks/resolver.py
@@ -269,8 +269,14 @@ class _Resolver:
         ``UNSUPPORTED_SAFE_OPEN`` and ``RESOURCE_LIMIT`` are class ``G`` and
         therefore carry no path, even though the observation that produced them
         named one.
+
+        Every failed observation may carry an errno, but only
+        ``FILESYSTEM_ERROR`` renders one; every other code has a fixed detail
+        and ``diagnostic_detail`` refuses an errno it would not render.
         """
 
+        if code != "FILESYSTEM_ERROR":
+            errno_value = None
         if DIAGNOSTIC_SPECS[code].fields == "G":
             self.findings.add(code, errno_value=errno_value)
             return
diff --git a/tests/unit/test_techstack_model.py b/tests/unit/test_techstack_model.py
index 9af99e2..77d18a9 100644
--- a/tests/unit/test_techstack_model.py
+++ b/tests/unit/test_techstack_model.py
@@ -656,6 +656,27 @@ class DiagnosticRegistryTest(unittest.TestCase):
             self.assertEqual("P", spec.fields)
             self.assertFalse(spec.waivable)
 
+    def test_an_errno_on_a_code_that_renders_none_is_a_caller_error(self):
+        for code, slots in (
+            ("UNREADABLE_FILE", {}),
+            ("INVALID_LEAF", {"line": 1, "rule": "LINE_SHAPE"}),
+        ):
+            with self.subTest(code=code):
+                with self.assertRaisesRegex(ValueError, f"^{code} must not carry errno_value$"):
+                    model.diagnostic_detail(code, errno_value=13, **slots)
+
+    def test_a_leaf_slot_on_a_code_other_than_invalid_leaf_is_a_caller_error(self):
+        for code, slots in (
+            ("UNREADABLE_FILE", {"line": 1}),
+            ("UNREADABLE_FILE", {"rule": "LINE_SHAPE"}),
+            ("FILESYSTEM_ERROR", {"errno_value": 13, "line": 0, "rule": "LINE_SHAPE"}),
+        ):
+            with self.subTest(code=code, slots=slots):
+                with self.assertRaisesRegex(ValueError, f"^{code} must not carry "):
+                    model.diagnostic_detail(code, **slots)
+                with self.assertRaises(ValueError):
+                    model.diagnostic(code, path="techstacks/general.md", **slots)
+
 
