diff --git a/tests/contract/test_packaged_ledger_guidance_contract.py b/tests/contract/test_packaged_ledger_guidance_contract.py
new file mode 100644
index 0000000..8a49253
--- /dev/null
+++ b/tests/contract/test_packaged_ledger_guidance_contract.py
@@ -0,0 +1,173 @@
+"""The packaged skill's worker-ledger commands must run on the shipped CLI.
+
+Regression guard for WLG-001's residual risk: the packaged
+`herdr-orchestration` skill that `brichan init` installs said nothing about the
+worker ledger, so an installed coordinator never passed `--task` or attested a
+finish. The guidance now exists; these checks keep its command blocks
+executable against the installed entry points, so a renamed or removed flag
+fails `make check` instead of shipping stale instructions. The checkout-only
+`--ledger-file` must never appear as a usable installed option.
+"""
+
+import contextlib
+import io
+import json
+import re
+import shlex
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "src"))
+
+from brichan.orchestration import worker_launch, worker_ledger
+
+
+PACKAGED_SKILL = ROOT / "src/brichan/resources/dogfood_v1/skills/herdr-orchestration"
+COMMANDS = PACKAGED_SKILL / "references/commands.md"
+
+LAUNCH_ID = "00000000-0000-4000-8000-000000000000"
+
+
+def command_block(prefix: str) -> list[str]:
+    """Tokenize the one fenced `text` block that starts with ``prefix``.
+
+    Optional groups (`[...]`) are taken as written, so every documented flag
+    is exercised, and a trailing `...` repetition marker is dropped.
+    """
+
+    text = COMMANDS.read_text(encoding="utf-8")
+    blocks = [
+        block
+        for block in re.findall(r"```text\n(.*?)```", text, re.DOTALL)
+        if block.startswith(prefix)
+    ]
+    if len(blocks) != 1:
+        raise AssertionError(f"expected one block starting {prefix!r}: {blocks}")
+    joined = blocks[0].replace("\\\n", " ").replace("[", " ").replace("]", " ")
+    return [token for token in shlex.split(joined) if token != "..."]
+
+
+def substitute(tokens: list[str], values: dict[str, str]) -> list[str]:
+    result = [values.get(token, token) for token in tokens]
+    leftover = [token for token in result if token.startswith("<")]
+    if leftover:
+        raise AssertionError(f"unsubstituted placeholders: {leftover}")
+    return result
+
+
+def run_quietly(entrypoint, argv: list[str]) -> tuple[int, str]:
+    stderr = io.StringIO()
+    with contextlib.redirect_stderr(stderr), contextlib.redirect_stdout(
+        io.StringIO()
+    ):
+        try:
+            code = entrypoint(argv)
+        except SystemExit as exc:  # the launcher lets argparse exit directly
+            code = int(exc.code or 0)
+    return code, stderr.getvalue()
+
+
+class PackagedLedgerGuidanceContractTest(unittest.TestCase):
+    def setUp(self):
+        self.commands = COMMANDS.read_text(encoding="utf-8")
+        self.normalized = " ".join(self.commands.split())
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.target = Path(temp.name).resolve()
+
+    def make_installed_target_with_one_launch(self) -> Path:
+        (self.target / ".git").mkdir()
+        (self.target / ".brichan/ledger").mkdir(parents=True)
+        (self.target / ".brichan/manifest.json").write_text("{}\n", encoding="utf-8")
+        ledger = self.target / ".brichan/ledger/workers.jsonl"
+        ledger.write_text(
+            json.dumps({"event": "launched", "launch_id": LAUNCH_ID}) + "\n",
+            encoding="utf-8",
+        )
+        return ledger
+
+    def test_the_documented_finish_command_records_an_installed_attestation(self):
+        ledger = self.make_installed_target_with_one_launch()
+        tokens = command_block("brichan-herdr-worker-ledger finish")
+        self.assertEqual("brichan-herdr-worker-ledger", tokens[0])
+        argv = substitute(
+            tokens[1:],
+            {
+                "<absolute-target-project>": str(self.target),
+                "<brichan-name>": "brichan-worker",
+                "<uuid>": LAUNCH_ID,
+                "<repo-relative-path>": "projects/p/handoffs/T/worker-report.md",
+                "<citation>": "make check",
+                "<TASK-ID>": "T-1",
+                "<pane-id>": "p1",
+            },
+        )
+
+        code, stderr = run_quietly(worker_ledger.main, argv)
+
+        self.assertEqual(0, code, stderr)
+        records = [
+            json.loads(line)
+            for line in ledger.read_text(encoding="utf-8").splitlines()
+        ]
+        self.assertEqual("finished", records[-1]["event"])
+        self.assertEqual(LAUNCH_ID, records[-1]["launch_id"])
+        self.assertEqual("T-1", records[-1]["task_id"])
+
+    def test_the_documented_launch_command_parses_on_the_installed_launcher(self):
+        """Every documented launch flag, `--task` included, is accepted.
+
+        The launch cannot start here, so the check is that argument parsing
+        passes: a parse failure exits `2` with usage text, while this run stops
+        later with exit `1` because the temporary target is not initialized.
+        """
+
+        tokens = command_block("brichan-herdr-agent-start")
+        self.assertIn("--task", tokens)
+        argv = substitute(
+            tokens[1:],
+            {
+                "brichan-<name>": "brichan-worker",
+                "<coordinator-pane-id>": "p0",
+                "<absolute-target-project>": str(self.target),
+                "<plan|implement|review|scan>": "implement",
+                "<TASK-ID>": "T-1",
+            },
+        )
+
+        code, stderr = run_quietly(worker_launch.main, [*argv, "--dry-run"])
+
+        self.assertEqual(1, code, stderr)
+        self.assertNotIn("usage:", stderr)
+
+    def test_the_installed_guidance_never_offers_the_checkout_ledger_flag(self):
+        for block in re.findall(r"```text\n(.*?)```", self.commands, re.DOTALL):
+            self.assertNotIn("--ledger-file", block)
+        self.assertIn(
+            "`--ledger-file` is rejected as an unrecognized argument (exit `2`)",
+            self.normalized,
+        )
+        self.assertNotIn("projects/<slug>/ledger", self.commands)
+
+    def test_the_installed_guidance_states_the_ledger_rules(self):
+        for marker in (
+            "Pass `--task <TASK-ID>` on every launch",
+            "recorded verbatim and is never inferred when the flag is absent",
+            "An installed launch always writes the target's fixed "
+            "`.brichan/ledger/workers.jsonl`",
+            "--project <absolute-target-project>",
+            "A `finished` record is a coordinator attestation, not proof",
+            "matches no `launched` record",
+            "already has a `finished` record",
+            "without the `brichan-` prefix",
+            "empty or whitespace-only `--evidence` item",
+        ):
+            self.assertIn(marker, self.normalized, marker)
+
+
+if __name__ == "__main__":
+    unittest.main()
