+class ObservationErrnoTest(ProjectMixin, unittest.TestCase):
+    """An errno-carrying observation renders its slotless registry detail."""
+
+    @unittest.skipIf(os.geteuid() == 0, "root bypasses file permissions")
+    def test_an_unreadable_selected_rule_file_reports_without_raising(self):
+        self.write_base_fixture()
+        leaf = self.root / "techstacks" / "general.md"
+        os.chmod(leaf, 0o000)
+        self.addCleanup(os.chmod, leaf, 0o644)
+        resolution = self.resolve()
+        self.assertEqual("blocked", resolution.status)
+        self.assertEqual(("UNREADABLE_FILE",), self.codes(resolution))
+        self.assertEqual("techstacks/general.md", resolution.diagnostics[0].path)
+        self.assertEqual(
+            "a required file could not be read", resolution.diagnostics[0].detail
+        )
+
+    def test_a_general_class_observation_with_an_errno_reports_without_a_path(self):
+        # Fault injection: no real filesystem condition produces RESOURCE_LIMIT.
+        self.write_base_fixture()
+        original = resolver.read_project_file
+
+        def exhausted(root_fd, relative_path, limit):
+            if relative_path == "techstacks/general.md":
+                return fs.Observation(code="RESOURCE_LIMIT", errno_value=24)
+            return original(root_fd, relative_path, limit)
+
+        with mock.patch.object(resolver, "read_project_file", exhausted):
+            resolution = self.resolve()
+        self.assertEqual("blocked", resolution.status)
+        self.assertEqual(("RESOURCE_LIMIT",), self.codes(resolution))
+        self.assertIsNone(resolution.diagnostics[0].path)
+        self.assertEqual(
+            "a process filesystem resource was exhausted",
+            resolution.diagnostics[0].detail,
+        )
+
+
