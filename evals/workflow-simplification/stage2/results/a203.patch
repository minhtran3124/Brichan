+class DiagnosticDetailArgumentTest(unittest.TestCase):
+    """``diagnostic_detail`` refuses a non-``None`` argument its code has no slot for."""
+
+    def test_valid_calls_render_the_registry_detail_in_both_call_shapes(self):
+        for spec in model.DIAGNOSTIC_REGISTRY:
+            code = spec.code
+            with self.subTest(code=code):
+                if code == "FILESYSTEM_ERROR":
+                    for errno_value in (None, 0, 13):
+                        expected = model.filesystem_error_detail(errno_value)
+                        self.assertEqual(
+                            expected,
+                            model.diagnostic_detail(code, errno_value=errno_value),
+                        )
+                        self.assertEqual(
+                            expected,
+                            model.diagnostic_detail(
+                                code, errno_value=errno_value, line=None, rule=None
+                            ),
+                        )
+                elif code == "INVALID_LEAF":
+                    for line in (0, 1):
+                        expected = model.invalid_leaf_detail(line, "TITLE")
+                        self.assertEqual(
+                            expected,
+                            model.diagnostic_detail(code, line=line, rule="TITLE"),
+                        )
+                        self.assertEqual(
+                            expected,
+                            model.diagnostic_detail(
+                                code, errno_value=None, line=line, rule="TITLE"
+                            ),
+                        )
+                else:
+                    self.assertEqual(spec.detail, model.diagnostic_detail(code))
+                    self.assertEqual(
+                        spec.detail,
+                        model.diagnostic_detail(
+                            code, errno_value=None, line=None, rule=None
+                        ),
+                    )
+
+    def test_errno_refuses_for_every_code_without_an_errno_slot(self):
+        for spec in model.DIAGNOSTIC_REGISTRY:
+            # INVALID_LEAF without its slots already raises for the missing
+            # slots, so its errno refusal is covered with slots supplied below.
+            if spec.code in ("FILESYSTEM_ERROR", "INVALID_LEAF"):
+                continue
+            for errno_value in (13, 0):
+                with self.subTest(code=spec.code, errno_value=errno_value):
+                    with self.assertRaises(ValueError):
+                        model.diagnostic_detail(spec.code, errno_value=errno_value)
+
+    def test_invalid_leaf_refuses_errno_alongside_its_own_slots(self):
+        for errno_value in (13, 0):
+            with self.subTest(errno_value=errno_value):
+                with self.assertRaises(ValueError):
+                    model.diagnostic_detail(
+                        "INVALID_LEAF", errno_value=errno_value, line=1, rule="TITLE"
+                    )
+
+    def test_line_and_rule_refuse_for_every_code_without_leaf_slots(self):
+        for spec in model.DIAGNOSTIC_REGISTRY:
+            if spec.code == "INVALID_LEAF":
+                continue
+            for arguments in ({"line": 1}, {"line": 0}, {"rule": "LINE_SHAPE"}):
+                with self.subTest(code=spec.code, **arguments):
+                    with self.assertRaises(ValueError):
+                        model.diagnostic_detail(spec.code, **arguments)
+
+    def test_unknown_code_still_raises_key_error(self):
+        with self.assertRaises(KeyError):
+            model.diagnostic_detail("NO_SUCH_CODE")
+        with self.assertRaises(KeyError):
+            model.diagnostic_detail("NO_SUCH_CODE", line=1)
+
+    def test_factory_propagates_the_refusal(self):
+        with self.assertRaises(ValueError):
+            model.diagnostic("UNSUPPORTED_PLATFORM", errno_value=13)
+
+
