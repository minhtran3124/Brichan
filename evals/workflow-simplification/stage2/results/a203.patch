+        # detail, which has no slot for either and refuses a non-None value.
+        raw = document(BASE_MAP_LINES)
+        headed = list(BASE_MAP_LINES)
+        headed.insert(1, "### Extra")
+        overflow_rows = [
+            (f"c{index:02d}", f"techstacks/c{index:02d}.md", (f"src/c{index:02d}",))
+            for index in range(33)
