diff --git a/src/brichan/techstacks/model.py b/src/brichan/techstacks/model.py
index 4d393d8..9982da5 100644
--- a/src/brichan/techstacks/model.py
+++ b/src/brichan/techstacks/model.py
@@ -587,13 +587,25 @@ def diagnostic_detail(
     line: int | None = None,
     rule: str | None = None,
 ) -> str:
-    """Return the literal registry detail for one diagnostic code."""
+    """Return the literal registry detail for one diagnostic code.
+
+    A non-``None`` argument the code's detail has no slot for is a caller
+    error: silently dropping it would hide a misattributed errno, line, or
+    rule at the call site.
+    """
 
     if code == "FILESYSTEM_ERROR":
+        if line is not None or rule is not None:
+            raise ValueError("FILESYSTEM_ERROR detail takes only errno_value")
         return filesystem_error_detail(errno_value)
     if code == "INVALID_LEAF":
+        if errno_value is not None:
+            raise ValueError("INVALID_LEAF detail takes only line and rule")
         return invalid_leaf_detail(line, rule)
-    return DIAGNOSTIC_SPECS[code].detail
+    detail = DIAGNOSTIC_SPECS[code].detail
+    if errno_value is not None or line is not None or rule is not None:
+        raise ValueError(f"{code} detail takes no arguments")
+    return detail
 
 
