+        overflow_selectors = tuple(f"src/s{index:02d}" for index in range(17))
+        cases = (
+            ("bom", b"\xef\xbb\xbf" + raw, "INVALID_MAP"),
+            ("missing_terminal_lf", raw[:-1], "INVALID_MAP"),
+            ("outside_form", document(headed), "INVALID_MAP"),
+            (
+                "row_path",
+                document(map_lines([("alpha", "/techstacks/alpha.md", ("src/a",))])),
+                "INVALID_MAP",
+            ),
+            (
+                "duplicate_row_id",
+                document(
+                    map_lines(
+                        [
+                            ("alpha", "techstacks/alpha.md", ("src/a",)),
+                            ("alpha", "techstacks/beta.md", ("src/b",)),
+                        ]
+                    )
+                ),
+                "INVALID_MAP",
+            ),
+            ("map_rows", document(map_lines(overflow_rows)), "MAP_ROW_LIMIT"),
+            (
