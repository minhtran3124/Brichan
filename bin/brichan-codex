#!/bin/sh

set -eu

BRICHAN_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export BRICHAN_ROOT
PYTHONPATH="$BRICHAN_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

# Call the checkout entrypoint explicitly with this wrapper's own root, so
# checkout mode comes from the launch and never from BRICHAN_ROOT, the working
# directory, or the shape of a target repository.
exec python3 -c 'import sys; from brichan.cli.codex import checkout_main; raise SystemExit(checkout_main(sys.argv[1], sys.argv[2:]))' "$BRICHAN_ROOT" "$@"
